{
  "name": "flux-arena",
  "version": "0.34.3",
  "description": "FLUX — a fast systemic top-down arena shooter and fighter",
  "author": "FLUX contributors",
  "desktopName": "flux-arena.desktop",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "electron .",
    "start:desktop": "electron .",
    "start:friends": "electron . --friends",
    "start:server": "node scripts/serve.mjs",
    "start:remote": "node scripts/serve.mjs --host=0.0.0.0",
    "stop": "node scripts/stop-servers.mjs",
    "test": "node --test --test-concurrency=1 tests/desktop-runtime.test.mjs tests/desktop-security.test.mjs tests/desktop-tunnel.test.mjs tests/game-dom.test.mjs tests/lobbies.test.mjs tests/match.test.mjs tests/network-conditioner.test.mjs tests/network-invite.test.mjs tests/network-quality.test.mjs tests/overhaul.test.mjs tests/overhaul-runtime.test.mjs && node --test tests/network.test.mjs && node --test tests/server-control.test.mjs",
    "preflight:unify": "node scripts/unification-preflight.mjs",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:windows": "electron-builder --win nsis",
    "package:linux:verified": "node scripts/package-current.mjs --platform=linux",
    "package:windows:verified": "node scripts/package-current.mjs --platform=windows"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "linkedom": "0.18.13"
  },
  "build": {
    "appId": "io.fluxarena.game",
    "productName": "FLUX Arena",
    "protocols": [
      {
        "name": "FLUX Arena invite",
        "schemes": [
          "flux"
        ]
      }
    ],
    "artifactName": "FLUX-Arena-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "assets/**/*",
      "desktop/**/*",
      "scripts/serve.mjs",
      "src/**/*",
      "index.html",
      "styles.css",
      "package.json",
      "node_modules/ws/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "generalgroovy",
      "repo": "flux",
      "releaseType": "release"
    },
    "linux": {
      "category": "Game",
      "icon": "assets/flux-rune.png",
      "syncDesktopName": true,
      "synopsis": "Flow. Learn. Unleash. eXecute.",
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "icon": "assets/flux-rune.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
