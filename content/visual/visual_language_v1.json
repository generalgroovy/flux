{
  "schema_version": 1,
  "id": "flux-visual-language-v1",
  "authority": "presentation only; simulation, collision, visibility and outcomes remain authoritative elsewhere",
  "pixel_contract": {
    "design_viewport": [640, 360],
    "output_scale": 2,
    "supported_camera_percent": [50, 75, 100],
    "base_unit": 2,
    "nearest_neighbor": true,
    "snap_translation_to_output_pixel": true,
    "subpixel_simulation_preserved": true
  },
  "perspective_contract": {
    "projection": "top_down_cardinal_with_tilted_facades",
    "floor_axes": ["screen_horizontal", "screen_vertical"],
    "floor_tile_aspect_ratio": 1.0,
    "maximum_facade_rise_to_footprint_ratio": 0.85,
    "cardinal_navigation_unambiguous": true,
    "collision_footprint_visible": true,
    "door_threshold_visible": true,
    "foreground_cutaway_required": true,
    "forbid_diamond_grid": true,
    "forbid_art_owned_collision": true
  },
  "character_contract": {
    "style": "mature_compact_expressive_cartoon_pixel",
    "head_height_ratio": [0.20, 0.23],
    "grounded_cell": [96, 96],
    "grounded_pivot": [48, 84],
    "gameplay_height_pixels": [44, 76],
    "outline_pixels": [1, 2],
    "material_ramp_colors": [3, 5],
    "separate_ground_shadow": true,
    "required_silhouette_states": ["south", "east", "north", "jump", "cast", "hit"],
    "forbid_realistic_anatomy": true,
    "forbid_sexualized_design": true
  },
  "layers": [
    "deep_water",
    "world_foundation",
    "traversable_surface",
    "surface_detail",
    "architecture",
    "props",
    "actor_shadow",
    "actor",
    "spell_underlay",
    "spell",
    "spell_impact",
    "cutaway",
    "world_prompt",
    "visibility_mask",
    "combat_hud",
    "station_overlay",
    "diagnostics"
  ],
  "ramps": {
    "deep_water": ["#07171d", "#0f2c38", "#155064", "#258298", "#58d8dd"],
    "worldbone": ["#101315", "#202428", "#363a3d", "#55554f", "#88816e"],
    "warm_stone": ["#403424", "#6c5737", "#98805a", "#c2ac7b", "#e2d4a7"],
    "timber": ["#17120f", "#2c1d18", "#4c3024", "#755039", "#ad7a4a"],
